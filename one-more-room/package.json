{
  "name": "one-more-room",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build && npm run build:server",
    "build:client": "vite build",
    "build:server": "vite build --ssr server/main.ts --outDir dist-server --emptyOutDir",
    "room": "node dist-server/main.js",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "balance": "BALANCE=1 vitest run tests/balance.test.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.1",
    "qrcode": "^1.5.4",
    "react": "19.2",
    "react-dom": "19.2",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "5.9",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
